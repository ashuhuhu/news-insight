OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
GNEWS_API_KEY=your-gnews-key
# Leave empty to disable the password prompt (local development)
APP_PASSWORD=
# Postgres connection string; falls back to a local SQLite file (dev.db) when unset
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
